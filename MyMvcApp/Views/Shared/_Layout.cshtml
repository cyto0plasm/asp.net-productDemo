<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyMvcApp</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-white shadow">
        <div class="max-w-7xl mx-auto px-4">
            <div class="flex justify-between items-center h-16">
                
                <a class="text-xl font-bold text-gray-800"
                   asp-controller="Home" asp-action="Index">
                    Ecommerce
                </a>

                <nav class="space-x-6">
                    <a class="text-gray-600 hover:text-blue-600"
                       asp-controller="Home" asp-action="Index">
                        Home
                    </a>

                    <a class="text-gray-600 hover:text-blue-600"
                       asp-controller="Product" asp-action="Index">
                        Products
                    </a>

                    <a class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700"
                       asp-controller="Product" asp-action="Create">
                        Add Product
                    </a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow max-w-7xl mx-auto w-full px-4 py-8">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white shadow-inner">
        <div class="max-w-7xl mx-auto px-4 py-4 text-center text-gray-500">
            © 2026 - MyMvcApp
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>