@model MyMvcApp.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "_Layout";
}

<h1 class="text-3xl font-semibold text-gray-800 mb-10">
    Edit Product
</h1>

<div class="max-w-2xl mx-auto">

    <div class="bg-white border border-gray-200 rounded-xl 
                hover:shadow-md transition duration-200 p-8">

        <form asp-action="Edit" method="post" enctype="multipart/form-data"
              class="space-y-6">

            <!-- Hidden Id -->
            <input type="hidden" asp-for="Id" />

            <!-- Name -->
            <div>
                <label asp-for="Name"
                       class="block text-sm font-medium text-gray-700 mb-2">
                </label>

                <input asp-for="Name"
                       class="w-full border border-gray-300 rounded-lg 
                              px-4 py-2 focus:outline-none 
                              focus:ring-2 focus:ring-gray-400" />

                <span asp-validation-for="Name"
                      class="text-sm text-red-500">
                </span>
            </div>

            <!-- Price -->
            <div>
                <label asp-for="Price"
                       class="block text-sm font-medium text-gray-700 mb-2">
                </label>

                <input asp-for="Price"
                       class="w-full border border-gray-300 rounded-lg 
                              px-4 py-2 focus:outline-none 
                              focus:ring-2 focus:ring-gray-400" />

                <span asp-validation-for="Price"
                      class="text-sm text-red-500">
                </span>
            </div>

            <!-- Image -->
            <div>
                <label asp-for="ImageFile"
                       class="block text-sm font-medium text-gray-700 mb-2">
                </label>

                <input type="file" asp-for="ImageFile"
                       class="w-full border border-gray-300 rounded-lg 
                              px-4 py-2 bg-white" />

                <span asp-validation-for="ImageFile"
                      class="text-sm text-red-500">
                </span>
            </div>

            <!-- Buttons -->
            <div class="flex justify-between items-center pt-4">

                <a asp-action="Index"
                   class="text-sm font-medium text-blue-600 
                          hover:text-blue-800 transition">
                    ← Back
                </a>

                <button type="submit"
                        class="text-sm font-medium bg-gray-800 text-white 
                               px-5 py-2 rounded-lg 
                               hover:bg-gray-900 transition">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>